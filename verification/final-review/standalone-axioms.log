Erdos302.rationalPartialValue_cast (P : Finset ℕ) (S : Finset ↑(Nat.factoredNumbers P)) :
  ↑(Erdos302.rationalPartialValue P S) = Erdos302.primeDensity P * ∑ n ∈ S, ↑(Erdos302.smoothIncrement P ↑n) / ↑↑n
'Erdos302.rationalPartialValue_cast' depends on axioms: [propext, Classical.choice, Quot.sound]
Erdos302.rationalTail_cast (P : Finset ℕ) (S : Finset ↑(Nat.factoredNumbers P)) :
  ↑(Erdos302.rationalTail P S) = 1 - Erdos302.primeDensity P * ∑ n ∈ S, (↑↑n)⁻¹
'Erdos302.rationalTail_cast' depends on axioms: [propext, Classical.choice, Quot.sound]
Erdos302.primeDensity_mul_reciprocal_sum (P : Finset ℕ) :
  Erdos302.primeDensity P * ∑' (n : ↑(Nat.factoredNumbers P)), (↑↑n)⁻¹ = 1
'Erdos302.primeDensity_mul_reciprocal_sum' depends on axioms: [propext, Classical.choice, Quot.sound]
Erdos302.rational_enclosure_fixed_primes (P : Finset ℕ) (S : Finset ↑(Nat.factoredNumbers P)) :
  ↑(Erdos302.rationalPartialValue P S) ≤ Erdos302.smoothUpperValue P ∧
    Erdos302.smoothUpperValue P ≤ ↑(Erdos302.rationalPartialValue P S + Erdos302.rationalTail P S)
'Erdos302.rational_enclosure_fixed_primes' depends on axioms: [propext, Classical.choice, Quot.sound]
