    simpa only [Real.rpow_neg_one] using Real.rpow_le_rpow_of_exponent_le hc he
  have hm := mul_le_mul_of_nonneg_right hcPow (Real.rpow_nonneg hx.le e)
  have hh : c⁻¹ * x ^ e ≤ y ^ e := hm.trans h
