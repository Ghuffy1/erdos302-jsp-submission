theorem primeModulus_squarefree (P : Finset ℕ) : Squarefree (primeModulus P) := by
  unfold primeModulus
  refine Finset.squarefree_prod_of_pairwise_isCoprime (fun p hp q hq hpq => ?_)
    (fun p hp => (Finset.mem_filter.mp hp).2.squarefree)
