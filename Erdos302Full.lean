    obtain ⟨hna, hnq⟩ := Finset.mem_filter.mp hn
    exact Finset.mem_filter.mpr ⟨hA hna, hnq⟩
  have h := card_le_maximumCard hsub (hf q)
  rwa [maximumCard_fiber hqR] at h

