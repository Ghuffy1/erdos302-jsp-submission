/-!
A conditional analytic bridge. The assumptions in this module are explicit
arguments, not established facts about Erdős 302. The finite-prime limits and
uniform approximation must still be proved before this bridge can be applied.
-/

namespace Erdos302

open Filter
open scoped Topology

theorem tendsto_of_uniform_approximations
    (f : ℕ → ℝ) (F : ℕ → ℕ → ℝ) (U : ℕ → ℝ) (C : ℝ)
    (hF : ∀ V, Tendsto (F V) atTop (𝓝 (U V)))
    (hU : Tendsto U atTop (𝓝 C))
    (happrox : ∀ ε : ℝ, 0 < ε → ∃ V₀ : ℕ, ∀ V ≥ V₀,
      ∀ᶠ N : ℕ in atTop, |f N - F V N| < ε) :
    Tendsto f atTop (𝓝 C) := by
  apply Metric.tendsto_atTop.mpr
  intro ε hε
  have he : 0 < ε / 3 := by positivity
  obtain ⟨V₀, hV₀⟩ := happrox (ε / 3) he
  obtain ⟨V₁, hV₁⟩ := Metric.tendsto_atTop.mp hU (ε / 3) he
  let V := max V₀ V₁
  have hVC : dist (U V) C < ε / 3 := hV₁ V (le_max_right _ _)
  obtain ⟨N₀, hN₀⟩ := Filter.eventually_atTop.mp (hV₀ V (le_max_left _ _))
  obtain ⟨N₁, hN₁⟩ := Metric.tendsto_atTop.mp (hF V) (ε / 3) he
  refine ⟨max N₀ N₁, ?_⟩
  intro N hN
  have hNF := hN₀ N (le_trans (le_max_left _ _) hN)
  have hFU := hN₁ N (le_trans (le_max_right _ _) hN)
  have htriangle := dist_triangle (f N) (F V N) C
  have htriangle' := dist_triangle (F V N) (U V) C
  simp only [Real.dist_eq] at htriangle htriangle' hVC hFU ⊢
  linarith

end Erdos302

-- Source Erdos302/Specification.lean
/-!
Exact statements of the density and quantitative approximation results.

`DensityLimitStatement`, `RemovalEstimateStatement`, and
`EffectiveApproximationStatement` below define the propositions proved in
`Erdos302.Solution`. The fixed-prime limit is proved in `Erdos302.DensitySeries`.
-/

namespace Erdos302

open Filter
open scoped Topology

def primeSet (V : ℕ) : Finset ℕ := (Finset.range (2 * V + 1)).filter Nat.Prime

theorem primeSet_mono {V W : ℕ} (hVW : V ≤ W) : primeSet V ⊆ primeSet W := by
  intro p hp
  simp only [primeSet, Finset.mem_filter, Finset.mem_range] at hp ⊢
  exact ⟨by omega, hp.2⟩

def RetainedTriple (V a b c : ℕ) : Prop :=
  ∃ g u v : ℕ, 0 < g ∧ 0 < u ∧ u < v ∧ Nat.Coprime u v ∧
    u ∈ Nat.factoredNumbers (primeSet V) ∧
    v ∈ Nat.factoredNumbers (primeSet V) ∧
    u + v ∈ Nat.factoredNumbers (primeSet V) ∧
    a = g * u * v ∧ b = g * u * (u + v) ∧ c = g * v * (u + v)

def RelaxedFree (V : ℕ) (A : Finset ℕ) : Prop :=
  ∀ a ∈ A, ∀ b ∈ A, ∀ c ∈ A, ¬ RetainedTriple V a b c

theorem relaxedFree_empty (V : ℕ) : RelaxedFree V ∅ := by
  simp [RelaxedFree]

theorem noTriple_implies_relaxedFree {V : ℕ} {A : Finset ℕ}
    (hA : NoUnitFractionTriple A) : RelaxedFree V A := by
  intro a ha b hb c hc ht
  obtain ⟨g, u, v, hg, hu, huv, _, _, _, _, rfl, rfl, rfl⟩ := ht
  obtain ⟨heq, hab, hbc⟩ := parametric_triple hg hu huv
  exact hA _ ha _ hb _ hc hab.ne (lt_trans hab hbc).ne hbc.ne heq

theorem relaxedFree_mono {V : ℕ} {A B : Finset ℕ}
    (hAB : A ⊆ B) (hB : RelaxedFree V B) : RelaxedFree V A := by
  intro a ha b hb c hc
  exact hB a (hAB ha) b (hAB hb) c (hAB hc)

theorem retainedTriple_mono {V W a b c : ℕ} (hVW : V ≤ W)
    (ht : RetainedTriple V a b c) : RetainedTriple W a b c := by
  obtain ⟨g, u, v, hg, hu, huv, hcop, hsU, hsV, hsW, ha, hb, hc⟩ := ht
  have move {n : ℕ} (hn : n ∈ Nat.factoredNumbers (primeSet V)) :
      n ∈ Nat.factoredNumbers (primeSet W) := by
    rw [Nat.mem_factoredNumbers_iff_primeFactors_subset] at hn ⊢
    exact ⟨hn.1, hn.2.trans (primeSet_mono hVW)⟩
  exact ⟨g, u, v, hg, hu, huv, hcop, move hsU, move hsV, move hsW, ha, hb, hc⟩

noncomputable def relaxedExtremal (V N : ℕ) : ℕ :=
  maximumCard (RelaxedFree V) (Finset.Icc 1 N)

theorem extremal_le_relaxed (V N : ℕ) : extremal N ≤ relaxedExtremal V N := by
  obtain ⟨A, hA, hfree, hcard⟩ := exists_extremizer N
  rw [← hcard]
  exact card_le_maximumCard hA (noTriple_implies_relaxedFree hfree)

theorem relaxedExtremal_antitone (N : ℕ) : Antitone (fun V => relaxedExtremal V N) := by
  intro V W hVW
  obtain ⟨A, hA, hfree, hcard⟩ := exists_maximumCard (relaxedFree_empty W) (Finset.Icc 1 N)
  change maximumCard (RelaxedFree W) (Finset.Icc 1 N) ≤
    maximumCard (RelaxedFree V) (Finset.Icc 1 N)
  rw [← hcard]
  apply card_le_maximumCard hA
  intro a ha b hb c hc ht
  exact hfree a ha b hb c hc (retainedTriple_mono hVW ht)

noncomputable def U (V : ℕ) : ℝ := smoothUpperValue (primeSet V)

/-- The proposed constant, over exactly the cutoffs V >= 4. -/
noncomputable def claimedConstant : ℝ := sInf (Set.range (fun V : ℕ => U (V + 4)))

/-- The density-limit statement, matching the arbitrary-extremizer
function formulation of the original problem. -/
def DensityLimitStatement : Prop :=
  ∀ f : ℕ → ℕ, (∀ N, IsMaxNoTripleCard N (f N)) →
    Tendsto (fun N : ℕ => (f N : ℝ) / N) atTop (𝓝 claimedConstant)

/-- The quantitative deletion statement from the private refinement. -/
def RemovalEstimateStatement : Prop :=
  ∀ N V K : ℕ, 4 ≤ N → 4 ≤ V →
    0 ≤ (relaxedExtremal V N : ℝ) - extremal N ∧
    (relaxedExtremal V N : ℝ) - extremal N ≤
      (N : ℝ) * (500000 * Parameters.z ^ (-(K : ℤ)) +
        10 ^ 23 * Parameters.q ^ (3 * K) *
        (Real.rpow (Real.log V) (-(7 / 80 : ℝ)) +
          Real.rpow (Real.log N) (-(7 / 80 : ℝ))))

/-- The approximation-rate statement for the same U and C. -/
def EffectiveApproximationStatement : Prop :=
  ∀ V : ℕ, 4 ≤ V →
    0 ≤ U V - claimedConstant ∧
    U V - claimedConstant ≤ ((10 : ℝ) ^ 23 + 561000) *
      Real.rpow (Real.log V) (-(1 / 140 : ℝ))

/-- Finite-prime asymptotic target, proved by `Erdos302.fixedPrimeLimit`. -/
def FixedPrimeLimitStatement : Prop :=
  ∀ V : ℕ, 4 ≤ V →
    Tendsto (fun N : ℕ => (relaxedExtremal V N : ℝ) / N) atTop (𝓝 (U V))

end Erdos302

-- Source Erdos302/RemovalReduction.lean
namespace Erdos302

theorem smooth_of_le_two_mul {n V : ℕ} (hn : 0 < n) (hnV : n ≤ 2 * V) :
    n ∈ Nat.factoredNumbers (primeSet V) := by
  apply Nat.mem_factoredNumbers_iff_forall_le.mpr
  refine ⟨hn.ne', ?_⟩
  intro p hpn hp hpdvd
  simp only [primeSet, Finset.mem_filter, Finset.mem_range]
  exact ⟨by omega, hp⟩

theorem retained_of_parameter_le {g u v V : ℕ}
    (hg : 0 < g) (hu : 0 < u) (huv : u < v) (hcop : Nat.Coprime u v) (hvV : v ≤ V) :
    RetainedTriple V (g * u * v) (g * u * (u + v)) (g * v * (u + v)) := by
  refine ⟨g, u, v, hg, hu, huv, hcop, ?_, ?_, ?_, rfl, rfl, rfl⟩
  · exact smooth_of_le_two_mul hu (by omega)
  · exact smooth_of_le_two_mul (by omega) (by omega)
  · exact smooth_of_le_two_mul (by omega) (by omega)

def tripleOfParameters (t : ℕ × ℕ × ℕ) : ℕ × ℕ × ℕ :=
  (t.1 * t.2.1 * t.2.2,
    t.1 * t.2.1 * (t.2.1 + t.2.2), t.1 * t.2.2 * (t.2.1 + t.2.2))

noncomputable def largeRegularParameters (N V K : ℕ) : Finset (ℕ × ℕ × ℕ) := by
  classical
  let I := Finset.Icc 1 N
  exact (I ×ˢ (I ×ˢ I)).filter (fun t =>
    t.2.1 < t.2.2 ∧ V < t.2.2 ∧ Nat.Coprime t.2.1 t.2.2 ∧
    t.1 * t.2.2 * (t.2.1 + t.2.2) ≤ N ∧
    KRegular K (t.1 * t.2.1 * t.2.2) ∧
    KRegular K (t.1 * t.2.1 * (t.2.1 + t.2.2)) ∧
    KRegular K (t.1 * t.2.2 * (t.2.1 + t.2.2)))

theorem mem_largeRegularParameters {N V K g u v : ℕ} :
    (g, u, v) ∈ largeRegularParameters N V K ↔
      (1 ≤ g ∧ g ≤ N) ∧ (1 ≤ u ∧ u ≤ N) ∧ (1 ≤ v ∧ v ≤ N) ∧
      u < v ∧ V < v ∧ Nat.Coprime u v ∧ g * v * (u + v) ≤ N ∧
      KRegular K (g * u * v) ∧ KRegular K (g * u * (u + v)) ∧
      KRegular K (g * v * (u + v)) := by
  classical
  simp only [largeRegularParameters, Finset.mem_filter, Finset.mem_product, Finset.mem_Icc]
  tauto

theorem residual_triples_le_parameters {N V K : ℕ} (A : Finset ℕ)
    (hA : A ⊆ Finset.Icc 1 N) (hfree : RelaxedFree V A) :
    (orderedTriples (A \ irregularVertices N K)).card ≤
      (largeRegularParameters N V K).card := by
  classical
  have hreg (n : ℕ) (hn : n ∈ A \ irregularVertices N K) : KRegular K n := by
    obtain ⟨hnA, hnE⟩ := Finset.mem_sdiff.mp hn
    by_contra hnot
    exact hnE (Finset.mem_filter.mpr ⟨hA hnA, hnot⟩)
  have hsub : orderedTriples (A \ irregularVertices N K) ⊆
      (largeRegularParameters N V K).image tripleOfParameters := by
    rintro ⟨a, b, c⟩ ht
    obtain ⟨ha, hb, hc, hbc, heq⟩ := mem_orderedTriples.mp ht
    have haA := (Finset.mem_sdiff.mp ha).1
    have hbA := (Finset.mem_sdiff.mp hb).1
    have hcA := (Finset.mem_sdiff.mp hc).1
    obtain ⟨ha1, haN⟩ := Finset.mem_Icc.mp (hA haA)
    obtain ⟨hb1, hbN⟩ := Finset.mem_Icc.mp (hA hbA)
    obtain ⟨hc1, hcN⟩ := Finset.mem_Icc.mp (hA hcA)
    obtain ⟨g, u, v, hg, hu, huv, hcop, hpa, hpb, hpc⟩ :=
      exists_parametrization (by omega) (by omega) hbc heq
    have hv : 0 < v := by omega
    have hw : 0 < u + v := by omega
    have hgv : g * v ≤ c := by rw [hpc]; exact Nat.le_mul_of_pos_right _ hw
    have hgN : g ≤ N := (Nat.le_mul_of_pos_right g hv).trans (hgv.trans hcN)
    have hvN : v ≤ N := (Nat.le_mul_of_pos_left v hg).trans (hgv.trans hcN)
    have huN : u ≤ N := huv.le.trans hvN
    have hVv : V < v := by
      by_contra hnot
      have hvV : v ≤ V := by omega
      have hret := retained_of_parameter_le hg hu huv hcop hvV
      rw [← hpa, ← hpb, ← hpc] at hret
      exact hfree a haA b hbA c hcA hret
    refine Finset.mem_image.mpr ⟨(g, u, v), ?_, ?_⟩
    · apply mem_largeRegularParameters.mpr
      exact ⟨⟨hg, hgN⟩, ⟨hu, huN⟩, ⟨hv, hvN⟩, huv, hVv, hcop,
        hpc ▸ hcN, hpa ▸ hreg a ha, hpb ▸ hreg b hb, hpc ▸ hreg c hc⟩
    · simp only [tripleOfParameters, ← hpa, ← hpb, ← hpc]
  exact (Finset.card_le_card hsub).trans Finset.card_image_le

theorem relaxed_removal_reduction (N V K : ℕ) :
    (relaxedExtremal V N : ℝ) - extremal N ≤
      500000 * Parameters.z ^ (-(K : ℝ)) * N + (largeRegularParameters N V K).card := by
  obtain ⟨A, hA, hfree, hcard⟩ := exists_maximumCard (relaxedFree_empty V) (Finset.Icc 1 N)
  have hfinite := finite_removal_bound A (irregularVertices N K) hA
  have htriple := residual_triples_le_parameters (K := K) A hA hfree
  have hnat : relaxedExtremal V N ≤ extremal N + (irregularVertices N K).card +
      (largeRegularParameters N V K).card := by
    change A.card = relaxedExtremal V N at hcard
    omega
  have hreal : (relaxedExtremal V N : ℝ) ≤ extremal N + (irregularVertices N K).card +
      (largeRegularParameters N V K).card := by exact_mod_cast hnat
  have hex := irregular_card_bound N K
  linarith

theorem removalEstimate_of_largeRegular_bound
    (hcount : ∀ N V K : ℕ, 4 ≤ N → 4 ≤ V →
      ((largeRegularParameters N V K).card : ℝ) ≤
        (N : ℝ) * (10 ^ 23 * Parameters.q ^ (3 * K) *
          (Real.rpow (Real.log V) (-(7 / 80 : ℝ)) + Real.rpow (Real.log N) (-(7 / 80 : ℝ))))) :
    RemovalEstimateStatement := by
  intro N V K hN hV
  constructor
  · exact sub_nonneg.mpr (by exact_mod_cast extremal_le_relaxed V N)
  · have h := relaxed_removal_reduction N V K
    rw [Real.rpow_neg_natCast] at h
    have hc := hcount N V K hN hV
    calc
      (relaxedExtremal V N : ℝ) - extremal N ≤
          500000 * Parameters.z ^ (-(K : ℤ)) * N + (largeRegularParameters N V K).card := h
      _ ≤ 500000 * Parameters.z ^ (-(K : ℤ)) * N +
          (N : ℝ) * (10 ^ 23 * Parameters.q ^ (3 * K) *
            (Real.rpow (Real.log V) (-(7 / 80 : ℝ)) + Real.rpow (Real.log N) (-(7 / 80 : ℝ)))) :=
        add_le_add le_rfl hc
      _ = _ := by ring

end Erdos302

