end Erdos302

-- Source Erdos302/Core.lean
/-!
Private formalization of the finite arithmetic in Erdős problem 302.
The definition of `NoUnitFractionTriple` matches the original distinct-triple
problem. This module alone does not prove the density-limit theorem.
The finite problem definitions follow the Formal Conjectures Authors' 2026
ErdosProblems/302.lean (Apache-2.0), preserved in the parent source archive.
-/

namespace Erdos302

open Finset

/-- The original reciprocal equation, with the three distinctness conditions
kept in the admissibility definition below. -/
def ReciprocalEquation (a b c : ℕ) : Prop :=
  (1 : ℚ) / a = (1 : ℚ) / b + (1 : ℚ) / c

def NoUnitFractionTriple (A : Finset ℕ) : Prop :=
  ∀ a ∈ A, ∀ b ∈ A, ∀ c ∈ A, a ≠ b → a ≠ c → b ≠ c →
    ¬ ReciprocalEquation a b c

def IsMaxNoTripleCard (N m : ℕ) : Prop :=
  IsGreatest {k | ∃ A ⊆ Finset.Icc 1 N,
    NoUnitFractionTriple A ∧ A.card = k} m

theorem reciprocalEquation_iff {a b c : ℕ}
    (ha : 0 < a) (hb : 0 < b) (hc : 0 < c) :
    ReciprocalEquation a b c ↔ b * c = a * (b + c) := by
  have ha' : (a : ℚ) ≠ 0 := by exact_mod_cast ha.ne'
  have hb' : (b : ℚ) ≠ 0 := by exact_mod_cast hb.ne'
  have hc' : (c : ℚ) ≠ 0 := by exact_mod_cast hc.ne'
  unfold ReciprocalEquation
  constructor
  · intro h
    field_simp at h
    have h' : b * c = a * (c + b) := by exact_mod_cast h
    simpa only [add_comm] using h'
  · intro h
    have h' : (b : ℚ) * c = a * (b + c) := by exact_mod_cast h
    field_simp
    nlinarith

theorem noUnitFractionTriple_mono {A B : Finset ℕ}
    (hAB : A ⊆ B) (hB : NoUnitFractionTriple B) :
    NoUnitFractionTriple A := by
  intro a ha b hb c hc hab hac hbc
  exact hB a (hAB ha) b (hAB hb) c (hAB hc) hab hac hbc

theorem noUnitFractionTriple_empty : NoUnitFractionTriple ∅ := by
  simp [NoUnitFractionTriple]

noncomputable def admissibleSubsets (N : ℕ) : Finset (Finset ℕ) := by
  classical
  exact (Finset.Icc 1 N).powerset.filter NoUnitFractionTriple

noncomputable def extremal (N : ℕ) : ℕ :=
  (admissibleSubsets N).sup Finset.card

theorem mem_admissibleSubsets {N : ℕ} {A : Finset ℕ} :
    A ∈ admissibleSubsets N ↔ A ⊆ Finset.Icc 1 N ∧ NoUnitFractionTriple A := by
  classical
  simp [admissibleSubsets]

theorem admissibleSubsets_nonempty (N : ℕ) : (admissibleSubsets N).Nonempty := by
  exact ⟨∅, mem_admissibleSubsets.mpr ⟨empty_subset _, noUnitFractionTriple_empty⟩⟩

theorem card_le_extremal {N : ℕ} {A : Finset ℕ}
    (hA : A ⊆ Finset.Icc 1 N) (hfree : NoUnitFractionTriple A) :
    A.card ≤ extremal N := by
  exact Finset.le_sup (f := Finset.card) (mem_admissibleSubsets.mpr ⟨hA, hfree⟩)

theorem exists_extremizer (N : ℕ) :
    ∃ A ⊆ Finset.Icc 1 N, NoUnitFractionTriple A ∧ A.card = extremal N := by
  obtain ⟨A, hA, hcard⟩ :=
    Finset.exists_mem_eq_sup (admissibleSubsets N) (admissibleSubsets_nonempty N) Finset.card
  exact ⟨A, (mem_admissibleSubsets.mp hA).1, (mem_admissibleSubsets.mp hA).2, hcard.symm⟩

theorem extremal_isMax (N : ℕ) : IsMaxNoTripleCard N (extremal N) := by
  refine ⟨exists_extremizer N, ?_⟩
  rintro m ⟨A, hA, hfree, rfl⟩
  exact card_le_extremal hA hfree

theorem isMax_iff_eq_extremal {N m : ℕ} :
    IsMaxNoTripleCard N m ↔ m = extremal N := by
  constructor
  · intro hm
    exact le_antisymm ((extremal_isMax N).2 hm.1) (hm.2 (extremal_isMax N).1)
  · rintro rfl
    exact extremal_isMax N

theorem extremal_le (N : ℕ) : extremal N ≤ N := by
  obtain ⟨A, hA, _, hcard⟩ := exists_extremizer N
  have h := Finset.card_le_card hA
  rw [hcard] at h
  simpa using h

theorem extremal_mono : Monotone extremal := by
  intro N M hNM
  obtain ⟨A, hA, hfree, hcard⟩ := exists_extremizer N
  rw [← hcard]
  exact card_le_extremal (hA.trans (Finset.Icc_subset_Icc_right hNM)) hfree

theorem reciprocalEquation_symm {a b c : ℕ} :
    ReciprocalEquation a b c ↔ ReciprocalEquation a c b := by
  simp [ReciprocalEquation, add_comm]

theorem reciprocalEquation_first_lt {a b c : ℕ}
    (ha : 0 < a) (hb : 0 < b) (hc : 0 < c)
    (h : ReciprocalEquation a b c) : a < b ∧ a < c := by
  have hEq := (reciprocalEquation_iff ha hb hc).mp h
  constructor <;> nlinarith

/-- Every positive primitive-parameter tuple gives a valid ordered triple. -/
theorem parametric_triple {g u v : ℕ}
    (hg : 0 < g) (hu : 0 < u) (huv : u < v) :
    ReciprocalEquation (g * u * v) (g * u * (u + v)) (g * v * (u + v)) ∧
    g * u * v < g * u * (u + v) ∧
    g * u * (u + v) < g * v * (u + v) := by
  have hv : 0 < v := lt_trans hu huv
  have hw : 0 < u + v := by omega
  refine ⟨?_, ?_, ?_⟩
  · apply (reciprocalEquation_iff (by positivity) (by positivity) (by positivity)).mpr
    ring
  · nlinarith [Nat.mul_pos hg hu]
  · exact Nat.mul_lt_mul_of_pos_right (Nat.mul_lt_mul_of_pos_left huv hg) hw

/-- Every positive ordered solution has the coprime parametrization used in
the manuscripts. No number-theoretic estimate is assumed here. -/
theorem exists_parametrization {a b c : ℕ}
    (ha : 0 < a) (hb : 0 < b) (hbc : b < c)
    (h : ReciprocalEquation a b c) :
    ∃ g u v : ℕ, 0 < g ∧ 0 < u ∧ u < v ∧ Nat.Coprime u v ∧
      a = g * u * v ∧ b = g * u * (u + v) ∧ c = g * v * (u + v) := by
  have hc : 0 < c := lt_trans hb hbc
  obtain ⟨d, u, v, hd, hcop, hbu, hcv⟩ :=
    Nat.exists_coprime' (Nat.gcd_pos_of_pos_left c hb)
  have hu : 0 < u := by
    by_contra hnot
    have : u = 0 := by omega
    simp [this] at hbu
    omega
  have hv : 0 < v := by
    by_contra hnot
    have : v = 0 := by omega
    simp [this] at hcv
    omega
  have huv : u < v := (Nat.mul_lt_mul_right hd).mp (by
    simpa only [← hbu, ← hcv] using hbc)
  have hw : 0 < u + v := by omega
  have hEq := (reciprocalEquation_iff ha hb hc).mp h
  rw [hbu, hcv] at hEq
  have heq : d * u * v = a * (u + v) := by
    apply Nat.eq_of_mul_eq_mul_left hd
    nlinarith [hEq]
  have hcop' : Nat.Coprime (u + v) (u * v) := by
    apply Nat.Coprime.mul_right
    · simpa using hcop.symm
    · simpa using hcop
  have hdiv : u + v ∣ d := by
    apply hcop'.dvd_of_dvd_mul_right
    exact ⟨a, by nlinarith [heq]⟩
  obtain ⟨g, hgd⟩ := hdiv
  have hg : 0 < g := by nlinarith [hgd]
  refine ⟨g, u, v, hg, hu, huv, hcop, ?_, ?_, ?_⟩
  · apply Nat.eq_of_mul_eq_mul_left hw
    rw [hgd] at heq
    nlinarith [heq]
  · rw [hbu, hgd]
    ring
  · rw [hcv, hgd]
    ring

theorem primitive_gcd {u v : ℕ} (h : Nat.Coprime u v) :
    Nat.gcd (u * v) (Nat.gcd (u * (u + v)) (v * (u + v))) = 1 := by
  have h1 : Nat.Coprime u (u + v) := by simpa using h
  have h2 : Nat.Coprime v (u + v) := by simpa [add_comm] using h.symm
  have h3 : Nat.Coprime (u * v) (u + v) := h1.mul_left h2
  rw [Nat.gcd_mul_right, h.gcd_eq_one, one_mul]
  exact h3.gcd_eq_one

theorem parametric_gcd {g u v : ℕ} (h : Nat.Coprime u v) :
    Nat.gcd (g * u * v)
      (Nat.gcd (g * u * (u + v)) (g * v * (u + v))) = g := by
  simp only [Nat.mul_assoc, Nat.gcd_mul_left]
  rw [primitive_gcd h, mul_one]

/-- Uniqueness is essential: the scale and primitive parameters are genuinely
determined by the ordered triple, rather than merely giving a surjection. -/
theorem parametrization_unique {g u v g' u' v' : ℕ}
    (hg : 0 < g) (hu : 0 < u)
    (hcop : Nat.Coprime u v) (hcop' : Nat.Coprime u' v')
    (ha : g * u * v = g' * u' * v')
    (hb : g * u * (u + v) = g' * u' * (u' + v'))
    (hc : g * v * (u + v) = g' * v' * (u' + v')) :
    g = g' ∧ u = u' ∧ v = v' := by
  have hgEq : g = g' := by
    calc
      g = Nat.gcd (g * u * v)
          (Nat.gcd (g * u * (u + v)) (g * v * (u + v))) :=
        (parametric_gcd (g := g) hcop).symm
      _ = Nat.gcd (g' * u' * v')
          (Nat.gcd (g' * u' * (u' + v')) (g' * v' * (u' + v'))) := by rw [ha, hb, hc]
      _ = g' := parametric_gcd hcop'
  subst g'
  have huvEq : u * v = u' * v' := by
    apply Nat.eq_of_mul_eq_mul_left hg
    simpa only [Nat.mul_assoc] using ha
  have huwEq : u * (u + v) = u' * (u' + v') := by
    apply Nat.eq_of_mul_eq_mul_left hg
    simpa only [Nat.mul_assoc] using hb
  have huEq : u = u' := by nlinarith [huvEq, huwEq]
  subst u'
  have hvEq : v = v' := Nat.eq_of_mul_eq_mul_left hu huvEq
  exact ⟨rfl, rfl, hvEq⟩

end Erdos302

-- Source Erdos302/Deletion.lean
/-! The finite deletion step for the actual reciprocal equation. The cost is
the number of ordered residual triples, with no hidden asymptotic assumption. -/

namespace Erdos302

open Finset

noncomputable def orderedTriples (A : Finset ℕ) : Finset (ℕ × ℕ × ℕ) := by
  classical
  exact (A ×ˢ (A ×ˢ A)).filter (fun t => t.2.1 < t.2.2 ∧
    ReciprocalEquation t.1 t.2.1 t.2.2)

noncomputable def firstVertices (A : Finset ℕ) : Finset ℕ :=
  (orderedTriples A).image Prod.fst

noncomputable def deleteTriples (A : Finset ℕ) : Finset ℕ :=
  A \ firstVertices A

theorem mem_orderedTriples {A : Finset ℕ} {a b c : ℕ} :
    (a, b, c) ∈ orderedTriples A ↔
      a ∈ A ∧ b ∈ A ∧ c ∈ A ∧ b < c ∧ ReciprocalEquation a b c := by
  classical
  simp only [orderedTriples, mem_filter, mem_product]
  tauto

theorem deleteTriples_subset (A : Finset ℕ) : deleteTriples A ⊆ A :=
  Finset.sdiff_subset

theorem deleteTriples_free (A : Finset ℕ) :
    NoUnitFractionTriple (deleteTriples A) := by
  classical
  intro a ha b hb c hc _ _ hbc heq
  obtain ⟨haA, haNot⟩ := Finset.mem_sdiff.mp ha
  have hbA := deleteTriples_subset A hb
  have hcA := deleteTriples_subset A hc
  apply haNot
  rcases lt_or_gt_of_ne hbc with hlt | hgt
  · exact Finset.mem_image.mpr ⟨(a, b, c),
      mem_orderedTriples.mpr ⟨haA, hbA, hcA, hlt, heq⟩, rfl⟩
  · exact Finset.mem_image.mpr ⟨(a, c, b),
      mem_orderedTriples.mpr ⟨haA, hcA, hbA, hgt, reciprocalEquation_symm.mp heq⟩,
      rfl⟩

theorem deletion_card_bound (A : Finset ℕ) :
    A.card ≤ (deleteTriples A).card + (orderedTriples A).card := by
  have h := Finset.card_le_card_sdiff_add_card (s := A) (t := firstVertices A)
  have hi : (firstVertices A).card ≤ (orderedTriples A).card := Finset.card_image_le
  exact h.trans (Nat.add_le_add_left hi _)

/-- The deletion argument includes an arbitrary exceptional set, so that its
use with the regularity condition cannot silently omit exceptional vertices. -/
theorem finite_removal_bound {N : ℕ} (A E : Finset ℕ)
    (hA : A ⊆ Finset.Icc 1 N) :
    A.card ≤ extremal N + E.card + (orderedTriples (A \ E)).card := by
  have hsub : deleteTriples (A \ E) ⊆ Finset.Icc 1 N :=
    (deleteTriples_subset _).trans (Finset.sdiff_subset.trans hA)
  have hext := card_le_extremal hsub (deleteTriples_free (A \ E))
  have hdel := deletion_card_bound (A \ E)
  have hcost := Finset.card_le_card_sdiff_add_card (s := A) (t := E)
  omega

end Erdos302

-- Source Erdos302/FiniteApproximation.lean
/-! Finite maxima and the exact smooth-prefix series. No assertion connecting
the series to the large-N extremal density is made without proof. -/

namespace Erdos302

open Finset

noncomputable def maximumCard (good : Finset ℕ → Prop) (S : Finset ℕ) : ℕ := by
  classical
  exact (S.powerset.filter good).sup Finset.card

theorem card_le_maximumCard {good : Finset ℕ → Prop} {S A : Finset ℕ}
    (hAS : A ⊆ S) (hgood : good A) : A.card ≤ maximumCard good S := by
  classical
  exact Finset.le_sup (f := Finset.card) (by simp [hAS, hgood])

theorem exists_maximumCard {good : Finset ℕ → Prop} (hzero : good ∅) (S : Finset ℕ) :
    ∃ A ⊆ S, good A ∧ A.card = maximumCard good S := by
  classical
  have hne : (S.powerset.filter good).Nonempty := ⟨∅, by simp [hzero]⟩
  obtain ⟨A, hA, hcard⟩ := Finset.exists_mem_eq_sup (S.powerset.filter good) hne Finset.card
  simp only [Finset.mem_filter, Finset.mem_powerset] at hA
  exact ⟨A, hA.1, hA.2, hcard.symm⟩

theorem maximumCard_mono {good : Finset ℕ → Prop} (hzero : good ∅)
    {S T : Finset ℕ} (hST : S ⊆ T) : maximumCard good S ≤ maximumCard good T := by
  obtain ⟨A, hAS, hgood, hcard⟩ := exists_maximumCard hzero S
  rw [← hcard]
  exact card_le_maximumCard (hAS.trans hST) hgood

theorem maximumCard_insert_le {good : Finset ℕ → Prop} (hzero : good ∅)
    (hmono : ∀ A B : Finset ℕ, A ⊆ B → good B → good A)
    (S : Finset ℕ) (a : ℕ) : maximumCard good (insert a S) ≤ maximumCard good S + 1 := by
  classical
  obtain ⟨A, hAS, hgood, hcard⟩ := exists_maximumCard hzero (insert a S)
  have herase : A.erase a ⊆ S := by
    intro x hx
    obtain ⟨hxa, hxA⟩ := Finset.mem_erase.mp hx
    simpa [hxa] using hAS hxA
  have hfree : good (A.erase a) := hmono _ _ (Finset.erase_subset _ _) hgood
  have hbound := card_le_maximumCard herase hfree
  have hcardErase := Finset.pred_card_le_card_erase (s := A) (a := a)
  omega

noncomputable def smoothVertices (P : Finset ℕ) (N : ℕ) : Finset ℕ := by
  classical
  exact (Finset.Icc 1 N).filter (· ∈ Nat.factoredNumbers P)

theorem mem_smoothVertices {P : Finset ℕ} {N n : ℕ} :
    n ∈ smoothVertices P N ↔ 1 ≤ n ∧ n ≤ N ∧ n ∈ Nat.factoredNumbers P := by
  classical
  simp only [smoothVertices, Finset.mem_filter, Finset.mem_Icc]
  tauto

noncomputable def smoothAlpha (P : Finset ℕ) (N : ℕ) : ℕ :=
  maximumCard NoUnitFractionTriple (smoothVertices P N)

theorem smoothVertices_mono (P : Finset ℕ) : Monotone (smoothVertices P) := by
  intro N M hNM n hn
  obtain ⟨hpos, hbound, hsmooth⟩ := mem_smoothVertices.mp hn
  exact mem_smoothVertices.mpr ⟨hpos, hbound.trans hNM, hsmooth⟩

theorem smoothAlpha_mono (P : Finset ℕ) : Monotone (smoothAlpha P) := by
  intro N M hNM
  exact maximumCard_mono noUnitFractionTriple_empty (smoothVertices_mono P hNM)

theorem smoothAlpha_succ_le (P : Finset ℕ) (N : ℕ) :
    smoothAlpha P (N + 1) ≤ smoothAlpha P N + 1 := by
  classical
  have hsub : smoothVertices P (N + 1) ⊆ insert (N + 1) (smoothVertices P N) := by
    intro n hn
    obtain ⟨hpos, hbound, hsmooth⟩ := mem_smoothVertices.mp hn
    by_cases heq : n = N + 1
    · simp [heq]
    · exact Finset.mem_insert_of_mem (mem_smoothVertices.mpr ⟨hpos, by omega, hsmooth⟩)
  exact (maximumCard_mono noUnitFractionTriple_empty hsub).trans
    (maximumCard_insert_le noUnitFractionTriple_empty
      (fun _ _ hAB hB => noUnitFractionTriple_mono hAB hB) _ _)

theorem smoothAlpha_zero (P : Finset ℕ) : smoothAlpha P 0 = 0 := by
  classical
  simp [smoothAlpha, smoothVertices, maximumCard]

noncomputable def smoothIncrement (P : Finset ℕ) (n : ℕ) : ℕ :=
  smoothAlpha P n - smoothAlpha P (n - 1)

theorem smoothIncrement_le_one (P : Finset ℕ) (n : ℕ) : smoothIncrement P n ≤ 1 := by
  cases n with
  | zero => simp [smoothIncrement]
  | succ n =>
    have h := smoothAlpha_succ_le P n
    simpa only [smoothIncrement, Nat.add_sub_cancel] using Nat.sub_le_iff_le_add.mpr
      (show smoothAlpha P (n + 1) ≤ 1 + smoothAlpha P n by omega)

noncomputable def primeDensity (P : Finset ℕ) : ℝ :=
  ∏ p ∈ P with p.Prime, (1 - (p : ℝ)⁻¹)

noncomputable def smoothUpperValue (P : Finset ℕ) : ℝ :=
  primeDensity P * ∑' n : Nat.factoredNumbers P,
    (smoothIncrement P n : ℝ) / (n : ℕ)

theorem smoothUpperValue_series_summable (P : Finset ℕ) :
    Summable (fun n : Nat.factoredNumbers P => (smoothIncrement P n : ℝ) / (n : ℕ)) := by
  apply smooth_weighted_summable
  · intro n
    positivity
  · intro n
    exact_mod_cast smoothIncrement_le_one P n

theorem primeDensity_pos (P : Finset ℕ) : 0 < primeDensity P := by
  apply Finset.prod_pos
  intro p hp
  have hpPrime := (Finset.mem_filter.mp hp).2
  have hpinv : (p : ℝ)⁻¹ < 1 := by
    apply inv_lt_one_of_one_lt₀
    exact_mod_cast hpPrime.one_lt
  linarith

theorem smoothUpperValue_nonneg (P : Finset ℕ) : 0 ≤ smoothUpperValue P := by
  apply mul_nonneg (primeDensity_pos P).le
  exact tsum_nonneg (fun n => div_nonneg (Nat.cast_nonneg _) (Nat.cast_nonneg _))

theorem smoothUpperValue_le_one (P : Finset ℕ) : smoothUpperValue P ≤ 1 := by
  have hsum := smooth_weighted_sum_le P
    (fun n => (smoothIncrement P n : ℝ))
    (fun _ => Nat.cast_nonneg _) (fun n => by exact_mod_cast smoothIncrement_le_one P n)
  have hprod : (∏ p ∈ P with p.Prime, (1 - (p : ℝ)⁻¹)⁻¹) = (primeDensity P)⁻¹ := by
    simp [primeDensity]
  rw [hprod] at hsum
  unfold smoothUpperValue
  exact (mul_le_mul_of_nonneg_left hsum (primeDensity_pos P).le).trans_eq
    (mul_inv_cancel₀ (primeDensity_pos P).ne')

end Erdos302

