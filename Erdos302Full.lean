      ∑ d ∈ P, ∑ e ∈ P, w d * w e * (∑ a ∈ A, I (d.lcm e) a) := by
    rw [Finset.sum_congr rfl hpoint, Finset.sum_comm]
    apply Finset.sum_congr rfl
    intro d hd
    rw [Finset.sum_comm]
    apply Finset.sum_congr rfl
    intro e he
    rw [Finset.mul_sum]
  have herror (d : ℕ) (hd : d ∈ P) (e : ℕ) (he : e ∈ P) :
      w d * w e * ((∑ a ∈ A, I (d.lcm e) a) - T * s.nu (d.lcm e)) ≤
        R * |w d| * |w e| := by
