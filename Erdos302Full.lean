        Finset.sum_le_sum_of_subset_of_nonneg hGA (fun a ha hnot => sq_nonneg _)
  have hpoint (a : α) (ha : a ∈ A) :
      (∑ d ∈ P, w d * I d a) ^ 2 =
        ∑ d ∈ P, ∑ e ∈ P, w d * w e * I (d.lcm e) a := by
    rw [pow_two, Finset.sum_mul]
    apply Finset.sum_congr rfl
    intro d hd
    rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro e he
    rw [← hIprod a ha d hd e he]
    ring
