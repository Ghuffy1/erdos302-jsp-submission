  have hab : roughFactor (primeSet V) a = roughFactor (primeSet V) b := by rw [hq a ha, hq b hb]
  have hac : roughFactor (primeSet V) a = roughFactor (primeSet V) c := by rw [hq a ha, hq c hc]
