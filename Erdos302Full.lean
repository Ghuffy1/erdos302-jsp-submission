      roughFactor P n * smoothFactor P n = n := roughFactor_mul_smoothFactor hn
      _ = g * t := hfactor
      _ = roughFactor P n * (k * t) := by rw [hk]; ring
  apply Nat.mem_factoredNumbers_of_dvd (smoothFactor_mem P n)
  exact ⟨k, by simpa only [mul_comm] using hs⟩

