    (G.card : ℝ) ≤ ∑ a ∈ A, (∑ d ∈ P, w d * I d a) ^ 2 := hcard
    _ = ∑ d ∈ P, ∑ e ∈ P, w d * w e * (∑ a ∈ A, I (d.lcm e) a) := hexpand
    _ ≤ ∑ d ∈ P, ∑ e ∈ P,
