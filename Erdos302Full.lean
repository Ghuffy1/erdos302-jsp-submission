noncomputable def irregularVertices (N K : ℕ) : Finset ℕ := by
  classical
  exact (Finset.Icc 1 N).filter (fun n => ¬ KRegular K n)

theorem irregular_card_bound (N K : ℕ) :
    ((irregularVertices N K).card : ℝ) ≤
      500000 * Parameters.z ^ (-(K : ℝ)) * N := by
