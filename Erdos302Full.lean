/-- Cambie's construction of small odd integers and the upper half interval. -/
def cambieSet (N : ℕ) : Finset ℕ :=
  (Finset.range ((N / 4 + 1) / 2)).image (fun k => 2 * k + 1) ∪ Finset.Ioc (N / 2) N

